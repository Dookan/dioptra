# Copy to .env and fill in. .env is gitignored and MUST NEVER be committed.
# Generate secrets with:  openssl rand -base64 48

# dev enables /api/docs and the seed command; prod disables both.
DIOPTRA_ENV=dev

# 32 characters minimum — the API refuses to boot with anything shorter.
DIOPTRA_JWT_SECRET=

# Set to false ONLY for local HTTP development; the refresh cookie needs HTTPS.
DIOPTRA_REFRESH_COOKIE_SECURE=true

# Database. POSTGRES_USER owns the schema and runs the migrations; the API and
# the worker connect as `dioptra_app`, a runtime role that can read and write
# rows but cannot alter tables or drop the append-only triggers (P5 day 20).
POSTGRES_USER=dioptra
POSTGRES_PASSWORD=
POSTGRES_DB=dioptra
DIOPTRA_APP_DB_PASSWORD=

# Host port for the web UI
DIOPTRA_HTTP_PORT=8080

# Development seed accounts. Every seeded account is forced to change its
# password on first login. Leave empty in production: seeding is refused there.
DIOPTRA_SEED_PASSWORD_AMEDINA=
DIOPTRA_SEED_PASSWORD_MMARIN=
DIOPTRA_SEED_PASSWORD_CPEREZ=

# --- Phase 1: analysis pipeline ---
# Host directory shared with the api and worker containers at the same path.
# Create it once:  sudo mkdir -p /var/lib/dioptra/{workspaces,osv,runs,vulndb} && sudo chown -R 10001:10001 /var/lib/dioptra
# It holds the per-analysis jails and the local OSV database
# (scripts/osv_db_download.sh /var/lib/dioptra/osv). Without the database,
# OSV-Scanner is reported as a coverage gap instead of querying anything.
DIOPTRA_DATA_DIR=/var/lib/dioptra
# GID of the host's docker socket, so the worker (uid 10001) may start the
# analysis containers:  stat -c %g /var/run/docker.sock
DIOPTRA_DOCKER_GID=999
# Resource ceilings for every analysis container.
# DIOPTRA_RUNNER_TIMEOUT_SECONDS=600
# DIOPTRA_RUNNER_MEMORY=2g
# DIOPTRA_RUNNER_CPUS=2
# uid:gid the analysis containers run as (never root). It must own the jails
# the API/worker create: 10001 in the shipped images; a developer running the
# API on the host sets `$(id -u):$(id -g)`.
# DIOPTRA_RUNNER_USER=10001:10001

# --- Phase 5: the local vulnerability mirror (OSV + NVD) ---
# The worker downloads the public dumps on a schedule — the ONLY outbound
# connection of the stack. On an air-gapped host set it to false and import
# the dump files through the inventory panel ("Importar base de vulnerabilidades").
DIOPTRA_VULNDB_SYNC_ENABLED=true
DIOPTRA_VULNDB_SYNC_INTERVAL_HOURS=24
# A dump file (download or import) is capped at 200 MiB, the same body cap
# nginx enforces on /api/ (docker/nginx.conf); raise both together or neither.
# DIOPTRA_VULNDB_MAX_DUMP_BYTES=209715200
# Endpoints are HTTPS-only and never settable through the API:
# DIOPTRA_VULNDB_OSV_BASE_URL=https://osv-vulnerabilities.storage.googleapis.com
# DIOPTRA_VULNDB_NVD_BASE_URL=https://nvd.nist.gov/feeds/json/cve/2.0
# DIOPTRA_VULNDB_OSV_ECOSYSTEMS=["npm","PyPI","Packagist","Maven","Go"]
# DIOPTRA_VULNDB_NVD_YEARS=[2024,2025,2026]
