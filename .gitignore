# Secrets — never committed (CLAUDE.md → Hard Rules)
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# Mutation testing scratch (mutmut copies app/ + tests/ into mutants/)
mutants/
.mutmut-cache
mutmut-stats.json

# Node
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo
npm-debug.log*

# Local runtime data
data/
workspaces/
*.sqlite3
*.db

# Editors / OS
.DS_Store
.idea/
.vscode/

# Panel agent scratch memory: local learning, not project history.
.claude/agent-memory/
# A panel agent invoked from a subdirectory writes its memory relative to its
# own cwd, which lands an `agent-memory` tree outside the root one (seen with
# `frontend/.claude/` on 2026-09-23). Agent memory is never committed, wherever
# it appears.
**/.claude/agent-memory/
